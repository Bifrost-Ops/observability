{
  "uid": "bifrost-platform",
  "title": "Bifrost | Platform Overview",
  "description": "Starter dashboard for Kubernetes health. Requires Prometheus with kube-state-metrics and node-exporter. Import/provision via Grafana; verify metric names in target stack.",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "timezone": "browser",
  "tags": [
    "bifrost",
    "kubernetes",
    "platform"
  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "type": "custom",
        "query": "management,service",
        "current": {
          "text": "management",
          "value": "management"
        },
        "options": [
          {
            "selected": true,
            "text": "management",
            "value": "management"
          },
          {
            "selected": false,
            "text": "service",
            "value": "service"
          }
        ]
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ready nodes",
      "description": "Requires kube-state-metrics. Cluster label must be attached by the Prometheus scrape/remote-write configuration.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\",cluster=\"$cluster\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Running pods",
      "description": "Shows running pods for the selected cluster.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_phase{phase=\"Running\",cluster=\"$cluster\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU utilization by node",
      "description": "Node exporter required. Expression excludes idle time.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\",cluster=\"$cluster\"}[5m])))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    }
  ]
}
